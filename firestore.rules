{
  "rules": {
    "numbers": {
      "$n": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.child('uid').val() == auth.uid && newData.child('uid').val() == data.child('uid').val()) || (newData.child('uid').val() == auth.uid && root.child('claims').child($n).child('uid').val() == auth.uid && root.child('claims').child($n).child('hash').val() == root.child('secrets').child($n).child('hash').val()))",

        "contacts": {
          "$c": {
            ".read": "auth != null && root.child('numbers').child($n).child('uid').val() == auth.uid",
            ".write": "auth != null && root.child('numbers').child($n).child('uid').val() == auth.uid"
          }
        },

        "chats": {
          "$p": {
            ".read": "auth != null && (root.child('numbers').child($n).child('uid').val() == auth.uid || root.child('numbers').child($p).child('uid').val() == auth.uid)",
            ".write": "auth != null && (root.child('numbers').child($n).child('uid').val() == auth.uid || root.child('numbers').child($p).child('uid').val() == auth.uid)"
          }
        }
      }
    },

    "secrets": {
      "$n": {
        ".read": false,
        ".write": "auth != null && !data.exists() && root.child('numbers').child($n).child('uid').val() == auth.uid"
      }
    },

    "claims": {
      "$n": {
        ".read": "auth != null && data.child('uid').val() == auth.uid",
        ".write": "auth != null && newData.child('uid').val() == auth.uid && newData.child('hash').val() == root.child('secrets').child($n).child('hash').val()"
      }
    },

    "chats": {
      "$cid": {
        "msgs": {
          "$mid": {
            ".read": "auth != null && (root.child('numbers').child(data.child('from').val()).child('uid').val() == auth.uid || root.child('numbers').child(data.child('to').val()).child('uid').val() == auth.uid)",
            ".write": "auth != null && ((!data.exists() && root.child('numbers').child(newData.child('from').val()).child('uid').val() == auth.uid) || (data.exists() && root.child('numbers').child(data.child('from').val()).child('uid').val() == auth.uid && newData.child('from').val() == data.child('from').val() && newData.child('to').val() == data.child('to').val() && newData.child('text').val() == data.child('text').val()))"
          }
        }
      }
    }
  }
}
